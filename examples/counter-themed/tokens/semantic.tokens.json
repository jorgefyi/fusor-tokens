{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{color.gray.0}",
      "subtle": { "$type": "color", "$value": "{color.gray.1}" },
      "muted": { "$type": "color", "$value": "{color.gray.2}" }
    },
    "fg": {
      "$type": "color",
      "$value": "{color.gray.12}",
      "muted": { "$type": "color", "$value": "{color.gray.9}" },
      "subtle": { "$type": "color", "$value": "{color.gray.7}" }
    },
    "border": {
      "$type": "color",
      "$value": "{color.gray.4}",
      "strong": { "$type": "color", "$value": "{color.gray.6}" }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.accent.9}",
      "fg": { "$type": "color", "$value": "{color.gray.0}" }
    },
    "danger": { "$type": "color", "$value": "{color.danger.9}" },
    "success": { "$type": "color", "$value": "{color.success.9}" },
    "warning": { "$type": "color", "$value": "{color.warning.9}" },
    "focus": {
      "ring": { "$type": "color", "$value": "{color.accent.6}" }
    }
  }
}

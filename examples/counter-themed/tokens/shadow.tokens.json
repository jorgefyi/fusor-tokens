{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "{color.shadow.sm}",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "{color.shadow.md}",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "{color.shadow.lg}",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  }
}
